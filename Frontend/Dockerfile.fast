# syntax=docker/dockerfile:1.4

# Stage 1: Build the Angular application
FROM node:20-alpine AS build

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies with cache mount for faster rebuilds
RUN --mount=type=cache,target=/root/.npm \
    npm ci --legacy-peer-deps --prefer-offline --no-audit 2>/dev/null || \
    npm install --legacy-peer-deps --prefer-offline --no-audit

# Copy source code
COPY . .

# Build the Angular app for production with cache
RUN --mount=type=cache,target=/app/.angular/cache \
    npm run build -- --configuration production

# Stage 2: Serve with Nginx
FROM nginx:alpine

# Copy the built app from build stage to Nginx
COPY --from=build /app/dist/print-media-enterprise/browser /usr/share/nginx/html

# Copy custom Nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose port 80
EXPOSE 80

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]
